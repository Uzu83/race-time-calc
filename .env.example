# Canonical origin for sitemap / OG / JSON-LD (required in Vercel Production)
NEXT_PUBLIC_SITE_URL=https://race-time-calc.vercel.app

# Optional tip jar override (defaults to https://ko-fi.com/uz_u83)
# NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/uz_u83

# Amazon Associates (JP) — leave empty to hide shoe CTA + footer disclosure
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=yourtag-22

# feedback-platform (feedback-adcd2). Leave empty to hide Feedback UI.
# Production only: NEXT_PUBLIC_FEEDBACK_TARGET=prod (omit elsewhere → feedback_dev)
# NEXT_PUBLIC_FEEDBACK_FIREBASE_API_KEY=
# NEXT_PUBLIC_FEEDBACK_FIREBASE_AUTH_DOMAIN=feedback-adcd2.firebaseapp.com
# NEXT_PUBLIC_FEEDBACK_FIREBASE_PROJECT_ID=feedback-adcd2
# NEXT_PUBLIC_FEEDBACK_FIREBASE_APP_ID=
# NEXT_PUBLIC_FEEDBACK_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FEEDBACK_FIREBASE_STORAGE_BUCKET=feedback-adcd2.firebasestorage.app
# NEXT_PUBLIC_FEEDBACK_TARGET=
